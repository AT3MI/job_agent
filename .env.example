# === GigaChat API ===
# Ключ авторизации из личного кабинета GigaChat (базовый ключ доступа).
# НИКОГДА не коммитьте .env и не публикуйте ключ.
GIGACHAT_CREDENTIALS=

# CA-сертификат Минцифры для доступа к API GigaChat.
# Скачайте: https://gu-st.ru/content/lending/russian_trusted_root_ca.pem
# и положите в корень проекта (путь относительный — от корня проекта).
GIGACHAT_CA_BUNDLE_FILE=russian_trusted_root_ca.pem

# === Контакты для письма ===
# Подставляются в closing сгенерированного письма. В git не попадают.
COVER_PHONE=89990000000
COVER_VK=https://vk.ru/example
COVER_NAME=Иванов Иван
